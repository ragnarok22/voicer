# Load with: uv run --env-file .env voicer "Hello"
OPENAI_API_KEY=your_api_key_here
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional current price per 1M TEXT INPUT tokens for the selected model.
# This is a partial estimate: generated audio output costs are excluded.
# Do not set this for tts-1/tts-1-hd (character-based billing).
# OPENAI_TTS_USD_PER_1M_TOKENS=your_current_price
